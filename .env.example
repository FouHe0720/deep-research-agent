# Offline works without any credentials. Bind server to loopback by default.
RESEARCH_DATA_DIR=.runtime
RESEARCH_ALLOW_LIVE=false
RESEARCH_MAX_JOBS=2
RESEARCH_MAX_QUEUE=20
# Optional inbound API protection when deploying beyond loopback.
# RESEARCH_API_KEY=
# Public APIs work without GitHub token; Brave Web search requires a key.
# RESEARCH_GITHUB_TOKEN=
# RESEARCH_WEB_API_KEY=
# Optional OpenAI-compatible integration. No model is called without a positive
# per-run dollar budget AND explicit input/output pricing configured below.
# RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# RESEARCH_LLM_API_KEY=
# RESEARCH_LLM_MODEL=
RESEARCH_LLM_KIND=openai
# RESEARCH_LLM_INPUT_USD_PER_MILLION=
# RESEARCH_LLM_OUTPUT_USD_PER_MILLION=
# Optional sibling service endpoints are operator supplied (loopback allowed).
# RESEARCH_GATEWAY_URL=
# RESEARCH_GATEWAY_API_KEY=
# RESEARCH_RAG_URL=
